# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# =============================================================================
# 以下为项目补充规则。原模板（通用 Unreal 模板）未覆盖这些，缺失会导致
# C# 构建产物被误提交 —— 曾出现 Script/*/obj/（74 个）与 bin/（45 个）入库。
# =============================================================================

# --- C# / .NET 构建产物 -----------------------------------------------------
obj/
bin/
**/obj/
**/bin/
Plugins/UnrealSharp/Build/Scripts/bin/
Plugins/UnrealSharp/Build/Scripts/obj/
Plugins/UnrealSharp/Build/Scripts/Intermediate/
*.csproj.user

# --- Python 虚拟环境（MCP 插件的 venv，可由 setup_mcp.ps1 重建）-------------
.venv/
**/.venv/

# --- 编辑器 / 工具的本机状态 -----------------------------------------------
.vscode/
.idea/
Backup/
.zcode/
*.log

# --- 解决方案文件：保留两个项目 sln ----------------------------------------
# 上面的 `*.sln` 会连它们一起忽略。但 RPG.sln 与 Script/ManagedRPG.sln 是
# 日常开发入口，且 UBT 用 -ProjectFiles 重新生成后需要重跑
# Tools/add_csharp_to_sln.py 补回 C# 工程，所以纳入版本控制更省事。
!RPG.sln
!Script/ManagedRPG.sln
